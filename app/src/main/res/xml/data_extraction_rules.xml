<?xml version="1.0" encoding="utf-8"?>
<!--
  All Mulplu state (app_state.json) stays on the device — the Play Data safety
  declaration of "no data collected" rests on that (#42, #53).

  android:allowBackup="false" alone closes cloud backup, device-to-device
  transfer and adb backup completely on API 28-30. These rules exist only for
  API 31+, where Google documents that allowBackup="false" does not reliably
  disable D2D transfer, and where a backup mode without rules is fully enabled.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
